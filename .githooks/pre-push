#!/bin/sh
set -eu
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        *[!0]*) ;;
        *) continue ;;
    esac
    if git rev-parse --verify "$local_oid^{commit}" >/dev/null 2>&1; then
        if test -n "$(git log -1 --format=%H "$local_oid" -- docs/)"; then
            echo "Push blocked: $local_ref contains private /docs/ history." >&2
            exit 1
        fi
    fi
done

ARG RUNPOD_BASE_IMAGE
FROM ${RUNPOD_BASE_IMAGE}

ARG K2CORE_REPOSITORY=https://github.com/soomrenald/k2core.git
ARG K2CORE_REF=237fd23dc4a578e9d1a095fac0587d4d6bdf88e4
ARG TORCH_VERSION=2.9.1
ARG TORCHVISION_VERSION=0.24.1
ARG TORCHAUDIO_VERSION=2.9.1
ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
ARG PIP_VERSION=26.2
ARG SETUPTOOLS_VERSION=83.0.0
ARG WHEEL_VERSION=0.47.0
ARG PACKAGING_VERSION=26.2

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    K2LAB_COMFYUI_ROOT=/opt/k2lab-native-runtime \
    K2LAB_CUDA_VERSION=12.8 \
    K2LAB_PYTORCH_VERSION=${TORCH_VERSION} \
    K2LAB_WORKER_PYTHON=/opt/k2lab-venv/bin/python \
    K2LAB_INFERENCE_BACKEND=native \
    K2LAB_NATIVE_TOKENIZER_PATH=/workspace/k2lab/models/tokenizers \
    K2LAB_NATIVE_TOKENIZER_SHA256=9362730d7f1fe82e277f363f2294f30edb2bb81b5c67b0d1b83813a5ac21f34d \
    K2LAB_WORKSPACE_ROOT=/workspace/k2lab

USER root

RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        python3.12 \
        python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/workspace/native-web-requirements.lock /tmp/native-web-requirements.lock

RUN python3.12 -m venv /opt/k2lab-venv \
    && /opt/k2lab-venv/bin/python -m pip install \
        "pip==${PIP_VERSION}" \
        "setuptools==${SETUPTOOLS_VERSION}" \
        "wheel==${WHEEL_VERSION}" \
        "packaging==${PACKAGING_VERSION}" \
    && /opt/k2lab-venv/bin/python -m pip install \
        "torch==${TORCH_VERSION}" \
        "torchvision==${TORCHVISION_VERSION}" \
        "torchaudio==${TORCHAUDIO_VERSION}" \
        --index-url "${PYTORCH_INDEX_URL}" \
    && /opt/k2lab-venv/bin/python -m pip install \
        "diffusers==0.39.0" \
        "safetensors==0.8.0" \
        "transformers==5.14.1" \
        "git+${K2CORE_REPOSITORY}@${K2CORE_REF}" \
    && /opt/k2lab-venv/bin/python -m pip install \
        --require-hashes \
        --requirement /tmp/native-web-requirements.lock

WORKDIR /opt/k2lab-runpod
COPY . /opt/k2lab-runpod

RUN /opt/k2lab-venv/bin/python -m pip install --no-deps /opt/k2lab-runpod \
    && chmod 0755 /opt/k2lab-runpod/deploy/workspace/entrypoint.sh

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD /opt/k2lab-venv/bin/python -c "import socket; socket.create_connection(('127.0.0.1', 8080), 3).close()"

ENTRYPOINT ["/opt/k2lab-runpod/deploy/workspace/entrypoint.sh"]
